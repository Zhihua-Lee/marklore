{
  "name": "marklore",
  "version": "0.3.3",
  "private": true,
  "type": "module",
  "description": "Independent offline Markdown notebook for Windows",
  "author": "Zhihua-Lee",
  "license": "MIT",
  "main": "desktop/main.mjs",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "playwright test",
    "test:native": "node tests/native.mjs",
    "test:native-safety": "node tests/native-safety.mjs",
    "test:native-menu": "node tests/native-menu.mjs",
    "test:native-export": "node tests/native-export.mjs",
    "test:native-background": "node tests/native-background.mjs",
    "test:native-drop-copy": "node tests/native-drop-copy.mjs",
    "test:native-editing": "node tests/native-editing.mjs",
    "test:native-navigation": "node tests/native-navigation.mjs",
    "test:native-image-access": "node tests/native-image-access.mjs",
    "test:native-update": "node tests/native-update.mjs",
    "test:native-gpu": "node tests/native-gpu.mjs",
    "test:native:all": "node tools/run-native-suites.mjs",
    "icons": "node tools/build-icons.mjs",
    "format": "prettier --write src desktop tests tools docs *.mjs *.json *.md",
    "format:check": "prettier --check src desktop tests tools docs *.mjs *.json *.md",
    "dist": "pnpm run notices && pnpm build && electron-builder --win --publish never",
    "notices": "node tools/licenses.mjs",
    "prune-releases": "node tools/prune-releases.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/literata": "5.3.0",
    "@lezer/highlight": "1.2.4",
    "codemirror": "6.0.2",
    "dompurify": "3.4.16",
    "highlight.js": "11.12.0",
    "katex": "0.18.9",
    "markdown-it": "15.0.3",
    "markdown-it-footnote": "4.0.0",
    "markdown-it-task-lists": "2.1.1",
    "mermaid": "12.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "electron": "44.9.3",
    "electron-builder": "26.15.3",
    "prettier": "3.9.9",
    "vite": "8.3.4"
  },
  "build": {
    "appId": "io.marklore.desktop",
    "productName": "Marklore",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "desktop/**",
      "package.json",
      "LICENSE",
      "THIRD-PARTY-NOTICES.txt",
      "!node_modules/**"
    ],
    "asar": true,
    "afterPack": "build/after-pack.cjs",
    "compression": "maximum",
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "win": {
      "target": [
        "dir",
        "nsis"
      ],
      "icon": "desktop/icons/folio.ico",
      "extraFiles": [
        "README.md",
        "README.zh-CN.md",
        "LICENSE",
        "THIRD-PARTY-NOTICES.txt"
      ],
      "signAndEditExecutable": true,
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Marklore",
      "uninstallDisplayName": "Marklore",
      "multiLanguageInstaller": true,
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ],
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh",
      "artifactName": "Marklore-Setup-v${version}-x64.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "desktop/icons/folio.icns",
      "extraResources": [
        "README.md",
        "README.zh-CN.md",
        "LICENSE",
        "THIRD-PARTY-NOTICES.txt"
      ],
      "category": "public.app-category.productivity",
      "identity": "-",
      "hardenedRuntime": false,
      "notarize": false,
      "electronLanguages": [
        "zh_CN",
        "en"
      ],
      "fileAssociations": [
        {
          "ext": [
            "md",
            "markdown"
          ],
          "name": "Markdown",
          "role": "Editor",
          "rank": "Default"
        },
        {
          "ext": [
            "diff",
            "patch"
          ],
          "name": "Diff",
          "role": "Viewer",
          "rank": "Alternate"
        }
      ],
      "artifactName": "Marklore-v${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "artifactName": "Marklore-v${version}-mac-${arch}.${ext}"
    }
  }
}
