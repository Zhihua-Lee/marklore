{
  "name": "folio-notes",
  "version": "0.1.14",
  "private": true,
  "type": "module",
  "description": "Independent offline Markdown notebook for Windows",
  "author": "Zhihua-Lee",
  "license": "UNLICENSED",
  "main": "desktop/main.mjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "playwright test",
    "test:native": "node tests/native.mjs",
    "test:native-safety": "node tests/native-safety.mjs",
    "test:native-menu": "node tests/native-menu.mjs",
    "test:native-export": "node tests/native-export.mjs",
    "test:native-background": "node tests/native-background.mjs",
    "test:native-drop-copy": "node tests/native-drop-copy.mjs",
    "icons": "node tools/build-icons.mjs",
    "format": "prettier --write src desktop tests tools *.mjs *.json *.md",
    "dist": "pnpm build && electron-builder --win dir --publish never",
    "licenses": "node tools/licenses.mjs"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/literata": "5.3.0",
    "codemirror": "6.0.2",
    "dompurify": "3.4.16",
    "highlight.js": "11.12.0",
    "katex": "0.18.9",
    "markdown-it": "15.0.2",
    "markdown-it-footnote": "4.0.0",
    "markdown-it-task-lists": "2.1.1",
    "mermaid": "12.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "prettier": "3.9.9",
    "vite": "8.3.1"
  },
  "build": {
    "appId": "io.folionotes.desktop",
    "productName": "Folio Notes",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "desktop/**",
      "package.json",
      "LICENSE",
      "THIRD-PARTY-NOTICES.txt",
      "!node_modules/**"
    ],
    "asar": true,
    "extraFiles": [
      "README.md",
      "LICENSE",
      "THIRD-PARTY-NOTICES.txt"
    ],
    "win": {
      "target": [
        "dir"
      ],
      "icon": "desktop/icons/folio.ico",
      "signAndEditExecutable": true,
      "signExecutable": false
    }
  }
}
