{
  "about": "Values checked against the JSON Schemas in ai-store/schemas (draft 2020-12): the files Marklore and its MCP server share in the 'ai' folder of the data folder. input: { schema (file name without '.schema.json'), value } → expected: whether the value is valid.",
  "cases": [
    {
      "name": "access",
      "input": {
        "schema": "access",
        "value": {
          "libraries": [{ "path": "C:\\Users\\me\\Notes" }],
          "excluded": ["C:\\Users\\me\\Notes\\Private"]
        }
      },
      "expected": true
    },
    {
      "name": "access, nothing open",
      "input": {
        "schema": "access",
        "value": { "libraries": [], "excluded": [] }
      },
      "expected": true
    },
    {
      "name": "access, posix and unc",
      "input": {
        "schema": "access",
        "value": {
          "libraries": [{ "path": "/Users/me/Notes" }],
          "excluded": ["\\\\server\\share\\x", "/Users/me/Notes/.git"]
        }
      },
      "expected": true
    },
    {
      "name": "access, relative excluded path",
      "input": {
        "schema": "access",
        "value": { "libraries": [], "excluded": ["Notes/Private"] }
      },
      "expected": false
    },
    {
      "name": "access, library as a string",
      "input": {
        "schema": "access",
        "value": { "libraries": ["C:\\Notes"], "excluded": [] }
      },
      "expected": false
    },
    {
      "name": "access, missing excluded",
