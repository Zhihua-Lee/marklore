      },
      "expected": { "text": "[计划](归档/计划%20一.md)", "count": 1 }
    },
    {
      "name": "encoded cjk stays encoded",
      "input": {
        "text": "[计划](%E7%AC%94%E8%AE%B0/%E8%AE%A1%E5%88%92.md)",
        "file": "C:/kb/首页.md",
        "moves": [["C:/kb/笔记/计划.md", "C:/kb/归档/计划 一.md"]]
      },
      "expected": {
        "text": "[计划](%E5%BD%92%E6%A1%A3/%E8%AE%A1%E5%88%92%20%E4%B8%80.md)",
        "count": 1
      }
    },
    {
      "name": "reference definitions, images and html",
      "input": {
        "text": "Read [the plan][p] and ![chart](Plan.md).\n\n[p]: Plan.md#top \"The plan\"\n   [q]: <Plan.md>\n[^n]: Plan.md is a footnote, not a link.\n<a href=\"Plan.md\">x</a> <img src='Plan.md' alt=\"\">",
        "file": "C:/kb/notes/Index.md",
        "moves": [["C:/kb/notes/Plan.md", "C:/kb/notes/Roadmap.md"]]
      },
      "expected": {
        "text": "Read [the plan][p] and ![chart](Roadmap.md).\n\n[p]: Roadmap.md#top \"The plan\"\n   [q]: <Roadmap.md>\n[^n]: Plan.md is a footnote, not a link.\n<a href=\"Roadmap.md\">x</a> <img src='Roadmap.md' alt=\"\">",
        "count": 5
      }
    },
    {
      "name": "code blocks, code spans and comments",
      "input": {
        "text": "Use `[x](Plan.md)` in text.\n\n```md\n[x](Plan.md)\n```\n\n~~~\n[x](Plan.md)\n~~~\n<!-- [x](Plan.md) -->\nReal: [x](Plan.md)",
        "file": "C:/kb/notes/Index.md",
        "moves": [["C:/kb/notes/Plan.md", "C:/kb/notes/Roadmap.md"]]
      },
      "expected": {
        "text": "Use `[x](Plan.md)` in text.\n\n```md\n[x](Plan.md)\n```\n\n~~~\n[x](Plan.md)\n~~~\n<!-- [x](Plan.md) -->\nReal: [x](Roadmap.md)",
        "count": 1
      }
    },
    {
      "name": "letter case of the link",
      "input": {
        "text": "[p](plan.MD)",
        "file": "C:/kb/notes/Index.md",
        "moves": [["C:/kb/notes/Plan.md", "C:/kb/notes/Roadmap.md"]]
