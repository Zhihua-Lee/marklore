{
  "about": "A note's links written again after notes, folders or files moved or were renamed, and after headings were renamed. input: { text, file (where the note is after the moves), from? (where it was; default file), moves: [[old, new]] (paths of notes, folders, files; the longest old path that contains a link's target applies), anchors?: [{ file, from, to }] (a heading of `file` renamed: links to it with the anchor `from`, letter case aside, get `to`) }. Paths are 'C:/…', 'C:\\…', '/…' or '//server/share/…', compared without regard to letter case. Inline links and images, reference definitions (not footnotes) and the href/src of <a>, <img>, <source>, <video>, <audio>, <iframe>, <embed> are rewritten relative to the note's folder; what is around the path stays as written: #anchor, ?query, title, angle brackets, a leading './', a trailing '/', and the encoding (a path written with %20 gets %20 for spaces; one with percent-encoded non-ASCII gets non-ASCII encoded; '%', '#', '?', control characters, '<' and '>' always encoded; '(' and ')' encoded in a bare inline destination). A link whose target did not move, in a note that did not move, keeps its path exactly (only its anchor may change). Left alone: links in fenced or indented code, code spans and HTML comments; web addresses and anything with a scheme (a drive letter reads as one); absolute paths; a destination that does not percent-decode; a target that would be on another drive. expected: { text, count (destinations changed) }.",
  "cases": [
    {
      "name": "a renamed note, the rest byte for byte",
      "input": {
        "text": "See [the plan](Plan.md) and [other](Other.md).\n\n![pic](assets/a.png)\n",
        "file": "C:/kb/notes/Index.md",
        "moves": [["C:/kb/notes/Plan.md", "C:/kb/notes/Roadmap.md"]]
      },
      "expected": {
        "text": "See [the plan](Roadmap.md) and [other](Other.md).\n\n![pic](assets/a.png)\n",
        "count": 1
      }
    },
    {
      "name": "no links",
      "input": {
        "text": "No links here.\n",
        "file": "C:/kb/notes/Index.md",
        "moves": [["C:/kb/notes/Plan.md", "C:/kb/notes/Roadmap.md"]]
      },
      "expected": { "text": "No links here.\n", "count": 0 }
    },
    {
      "name": "anchor, title, angle brackets, dot slash",
      "input": {
        "text": "[a](Plan.md#goals) [b](./Plan.md 'T') [c](<Plan.md#x> \"Title\")",
        "file": "C:/kb/notes/Index.md",
        "moves": [["C:/kb/notes/Plan.md", "C:/kb/notes/Roadmap.md"]]
      },
      "expected": {
        "text": "[a](Roadmap.md#goals) [b](./Roadmap.md 'T') [c](<Roadmap.md#x> \"Title\")",
        "count": 3
      }
    },
    {
      "name": "query and an anchor in the note",
      "input": {
        "text": "[q](Plan.md?x=1) [s](#top)",
        "file": "C:/kb/notes/Index.md",
        "moves": [["C:/kb/notes/Plan.md", "C:/kb/notes/Roadmap.md"]]
      },
      "expected": { "text": "[q](Roadmap.md?x=1) [s](#top)", "count": 1 }
    },
    {
      "name": "line and column anchor",
      "input": {
        "text": "[l](Plan.md#L40C5)",
        "file": "C:/kb/notes/Index.md",
        "moves": [["C:/kb/notes/Plan.md", "C:/kb/notes/Roadmap.md"]]
      },
      "expected": { "text": "[l](Roadmap.md#L40C5)", "count": 1 }
    },
    {
      "name": "up and across",
      "input": {
        "text": "[p](../notes/Plan.md)",
        "file": "C:/kb/other/A.md",
        "moves": [["C:/kb/notes/Plan.md", "C:/kb/archive/2024/Plan.md"]]
      },
      "expected": { "text": "[p](../archive/2024/Plan.md)", "count": 1 }
    },
    {
      "name": "down",
      "input": {
        "text": "[p](notes/Plan.md)",
        "file": "C:/kb/Top.md",
        "moves": [["C:/kb/notes/Plan.md", "C:/kb/archive/2024/Plan.md"]]
      },
      "expected": { "text": "[p](archive/2024/Plan.md)", "count": 1 }
    },
    {
      "name": "into the same folder",
      "input": {
        "text": "[p](../../notes/Plan.md)",
        "file": "C:/kb/archive/2024/Sibling.md",
        "moves": [["C:/kb/notes/Plan.md", "C:/kb/archive/2024/Plan.md"]]
      },
      "expected": { "text": "[p](Plan.md)", "count": 1 }
    },
    {
      "name": "percent-encoded spaces and parentheses",
      "input": {
        "text": "[p](My%20Plan.md)",
        "file": "C:/kb/A.md",
        "moves": [["C:/kb/My Plan.md", "C:/kb/Our plan (v2).md"]]
      },
      "expected": { "text": "[p](Our%20plan%20%28v2%29.md)", "count": 1 }
    },
    {
      "name": "angle brackets keep plain spaces",
      "input": {
        "text": "[p](<My Plan.md>)",
        "file": "C:/kb/A.md",
        "moves": [["C:/kb/My Plan.md", "C:/kb/Our plan (v2).md"]]
      },
      "expected": { "text": "[p](<Our plan (v2).md>)", "count": 1 }
    },
    {
      "name": "angle brackets with %20",
      "input": {
        "text": "[p](<My%20Plan.md>)",
        "file": "C:/kb/A.md",
        "moves": [["C:/kb/My Plan.md", "C:/kb/Our plan (v2).md"]]
      },
      "expected": { "text": "[p](<Our%20plan%20(v2).md>)", "count": 1 }
    },
    {
      "name": "a literal percent and hash are encoded",
      "input": {
        "text": "[p](My%20Plan.md)",
        "file": "C:/kb/A.md",
        "moves": [["C:/kb/My Plan.md", "C:/kb/50% #1.md"]]
      },
      "expected": { "text": "[p](50%25%20%231.md)", "count": 1 }
    },
    {
      "name": "plain cjk stays plain",
      "input": {
        "text": "[计划](笔记/计划.md)",
        "file": "C:/kb/首页.md",
