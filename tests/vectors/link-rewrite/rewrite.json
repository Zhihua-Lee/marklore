        "text": "[p](Plan.md (title))",
        "file": "C:/kb/notes/Index.md",
        "moves": [["C:/kb/notes/Plan.md", "C:/kb/notes/Roadmap.md"]]
      },
      "expected": { "text": "[p](Roadmap.md (title))", "count": 1 }
    },
    {
      "name": "comment over lines",
      "input": {
        "text": "<!--\n[x](Plan.md)\n-->\n[y](Plan.md)",
        "file": "C:/kb/notes/Index.md",
        "moves": [["C:/kb/notes/Plan.md", "C:/kb/notes/Roadmap.md"]]
      },
      "expected": {
        "text": "<!--\n[x](Plan.md)\n-->\n[y](Roadmap.md)",
        "count": 1
      }
    },
    {
      "name": "an anchor follows a renamed heading",
      "input": {
        "text": "[a](旧.md#旧) [b](%E6%97%A7.md#%E6%97%A7) [c](旧.md#别处) [d](其他.md#旧)",
        "file": "C:/kb/其他.md",
        "moves": [["C:/kb/旧.md", "C:/kb/新.md"]],
        "anchors": [{ "file": "C:/kb/新.md", "from": "旧", "to": "新" }]
      },
      "expected": {
        "text": "[a](新.md#新) [b](%E6%96%B0.md#%E6%96%B0) [c](新.md#别处) [d](其他.md#旧)",
        "count": 3
      }
    },
    {
      "name": "only the anchor changes: the path as written",
      "input": {
        "text": "[a](./sub/../旧.md#旧 \"t\")",
        "file": "C:/kb/x.md",
        "anchors": [{ "file": "C:/kb/旧.md", "from": "旧", "to": "新" }]
      },
      "expected": { "text": "[a](./sub/../旧.md#新 \"t\")", "count": 1 }
    },
    {
      "name": "the note's own anchors",
      "input": {
        "text": "[top](#旧) [x](#其他)",
        "file": "C:/kb/新.md",
        "from": "C:/kb/旧.md",
        "moves": [["C:/kb/旧.md", "C:/kb/新.md"]],
        "anchors": [{ "file": "C:/kb/新.md", "from": "旧", "to": "新" }]
      },
      "expected": { "text": "[top](#新) [x](#其他)", "count": 1 }
    },
    {
      "name": "anchor letter case",
      "input": {
        "text": "[a](Doc.md#Intro) [b](Doc.md#INTRO)",
        "file": "C:/kb/x.md",
        "anchors": [
          { "file": "C:/kb/Doc.md", "from": "intro", "to": "overview" }
        ]
      },
      "expected": {
        "text": "[a](Doc.md#overview) [b](Doc.md#overview)",
        "count": 2
      }
    },
    {
      "name": "anchor with a space in angle brackets",
      "input": {
        "text": "[a](<Doc.md#old>) [b](Doc.md#old)",
        "file": "C:/kb/x.md",
        "anchors": [{ "file": "C:/kb/Doc.md", "from": "old", "to": "new name" }]
      },
      "expected": {
        "text": "[a](<Doc.md#new%20name>) [b](Doc.md#new%20name)",
        "count": 2
      }
    },
    {
      "name": "an anchor in the note, angle brackets",
      "input": {
        "text": "[a](<#old>)",
        "file": "C:/kb/x.md",
        "anchors": [{ "file": "C:/kb/x.md", "from": "old", "to": "new" }]
      },
      "expected": { "text": "[a](<#new>)", "count": 1 }
    },
    {
      "name": "an anchor written encoded gets an encoded one",
      "input": {
        "text": "[a](#%E6%97%A7)",
        "file": "C:/kb/x.md",
        "anchors": [{ "file": "C:/kb/x.md", "from": "旧", "to": "新" }]
      },
      "expected": { "text": "[a](#%E6%96%B0)", "count": 1 }
    },
    {
      "name": "html anchor",
      "input": {
        "text": "<a href=\"Doc.md#old\">x</a>",
        "file": "C:/kb/x.md",
        "anchors": [{ "file": "C:/kb/Doc.md", "from": "old", "to": "a (b)" }]
      },
      "expected": { "text": "<a href=\"Doc.md#a%20(b)\">x</a>", "count": 1 }
    },
    {
      "name": "a reference definition's anchor",
      "input": {
        "text": "[r]: Doc.md#old\n",
        "file": "C:/kb/x.md",
        "anchors": [{ "file": "C:/kb/Doc.md", "from": "old", "to": "new" }]
      },
      "expected": { "text": "[r]: Doc.md#new\n", "count": 1 }
    }
  ]
}
